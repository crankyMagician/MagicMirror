# Private values for the mirror's config.js.
# setup-pi.sh copies this file to ~/MagicMirror/config/config.env on the Pi the
# first time it runs, and on later runs it adds any names that copy is missing.
# Edit that copy. It is not committed.

# Home location for the weather modules. These are placeholder coordinates
# (San Francisco). Replace them with the real ones.
MIRROR_LAT=37.7749
MIRROR_LON=-122.4194

# The date the days-together counter starts from, as YYYY-MM-DD. The counter
# stays hidden while this is empty.
MIRROR_TOGETHER_SINCE=

# The mirror's voice (MMM-Speak). The provider is elevenlabs or cartesia, and
# the voice is the id of a voice in that provider's account. Only the chosen
# provider needs a key. With no voice or no key the mirror stays silent.
MIRROR_SPEECH_PROVIDER=elevenlabs
MIRROR_SPEECH_VOICE=
SECRET_ELEVENLABS_API_KEY=
SECRET_CARTESIA_API_KEY=

# Countdowns for MMM-CountEvents, as one line of JSON inside single quotes.
# Each event has a title and a targetTime. "repeat": "yearly" counts down to
# the next anniversary of that date.
MIRROR_EVENTS='[{"title": "Christmas", "targetTime": "2026-12-25", "repeat": "yearly", "unit": "day"}]'

# Messages the mirror shows and says once on a special day, the first time
# that person is recognized. The date is MM-DD for every year or YYYY-MM-DD
# for one year. Leave out "person" for a message to everyone. Keep the JSON
# on one line.
# Example: [{"date": "12-25", "person": "heather", "line": "Merry Christmas, Heather."}]
# An anniversary can count its years: add "since" with the year it began and
# write {years} in the line, as in
# {"date": "06-01", "since": 2020, "line": "{years} years in this house today."}
MIRROR_SPECIAL_DAYS='[]'

# Login for the settings page, through the household's own login server.
# Leave MIRROR_AUTH_URL empty for no login. With it set, the page needs a
# signed-in account that is listed in MIRROR_ACCOUNTS (email -> person), and
# people open the page at https://MIRROR_SETTINGS_HOST/.
# Example: MIRROR_AUTH_URL=https://auth.home.example
#          MIRROR_SETTINGS_HOST=mirror.home.example
#          MIRROR_ACCOUNTS='{"someone@example.org": "sam"}'
MIRROR_AUTH_URL=
MIRROR_SETTINGS_HOST=
MIRROR_ACCOUNTS='{}'

# Addresses that may reach the settings page, separated by commas. Empty
# means the two home subnets. With login on and the page behind an HTTPS
# proxy, name only the proxy here, so the plain HTTP port answers nobody else.
# Example: MIRROR_SETTINGS_ALLOW=192.168.10.212
MIRROR_SETTINGS_ALLOW=

# Lights, through the household's Home Assistant. MIRROR_HA_URL is where it
# answers, and the token is a long-lived access token of a Home Assistant
# user made for the mirror. With the address empty the mirror has no light
# commands and no light card.
# Example: MIRROR_HA_URL=http://192.168.10.212:8123
MIRROR_HA_URL=
# The station MMM-Radio plays on the mirror's speaker while the switch
# input_boolean.christmas_music is on in Home Assistant. Empty uses SomaFM's
# Christmas Lounge.
MIRROR_RADIO_STREAM=
SECRET_HA_TOKEN=
