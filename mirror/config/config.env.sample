# Private values for the mirror's config.js.
# setup-pi.sh copies this file to ~/MagicMirror/config/config.env on the Pi the
# first time it runs, and on later runs it adds any names that copy is missing.
# Edit that copy. It is not committed.

# Home location for the weather modules. These are placeholder coordinates
# (San Francisco). Replace them with the real ones.
MIRROR_LAT=37.7749
MIRROR_LON=-122.4194

# The date the days-together counter starts from, as YYYY-MM-DD. The counter
# stays hidden while this is empty.
MIRROR_TOGETHER_SINCE=

# Countdowns for MMM-CountEvents, as one line of JSON inside single quotes.
# Each event has a title and a targetTime. "repeat": "yearly" counts down to
# the next anniversary of that date.
MIRROR_EVENTS='[{"title": "Christmas", "targetTime": "2026-12-25", "repeat": "yearly", "unit": "day"}]'
