# Private values for the mirror's config.js.
# setup-pi.sh copies this file to ~/MagicMirror/config/config.env on the Pi the
# first time it runs, and on later runs it adds any names that copy is missing.
# Edit that copy. It is not committed.

# Home location for the weather modules. These are placeholder coordinates
# (San Francisco). Replace them with the real ones.
MIRROR_LAT=37.7749
MIRROR_LON=-122.4194

# Private iCal links, one per person. The default is a public US holidays
# calendar so the modules have something to show.
SECRET_CALENDAR_URL_SAM=https://ics.calendarlabs.com/76/mm3137/US_Holidays.ics
SECRET_CALENDAR_URL_HEATHER=https://ics.calendarlabs.com/76/mm3137/US_Holidays.ics
