# Private values for the mirror's config.js.
# setup-pi.sh copies this file to ~/MagicMirror/config/config.env on the Pi the
# first time it runs. Edit that copy. It is not committed.

# Home location for the weather modules. These are placeholder coordinates
# (San Francisco). Replace them with the real ones.
MIRROR_LAT=37.7749
MIRROR_LON=-122.4194

# Private iCal link for the calendar module. The default is a public US
# holidays calendar so the module has something to show.
SECRET_CALENDAR_URL=https://ics.calendarlabs.com/76/mm3137/US_Holidays.ics
