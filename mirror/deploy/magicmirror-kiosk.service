# Template. setup-pi.sh fills in @USER@, @MM_DIR@ and @ETC_DIR@ and installs
# the result as /etc/systemd/system/magicmirror-kiosk.service.
#
# The unit runs sway on tty1. sway starts Electron, which shows the page of
# magicmirror-server.service, and exits when Electron exits, so Restart=always
# brings the whole session back after a crash. Stopping or losing the kiosk
# does not stop the server.

[Unit]
Description=MagicMirror kiosk (sway on tty1)
After=systemd-user-sessions.service network-online.target getty@tty1.service magicmirror-server.service
Wants=network-online.target magicmirror-server.service
Conflicts=getty@tty1.service

[Service]
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=@MM_DIR@
Environment=XDG_SESSION_TYPE=wayland
# The mirror has no keyboard or mouse. Without this sway refuses to start.
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/bin/sway --config @ETC_DIR@/sway.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
